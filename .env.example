# Port d'écoute du serveur Node.js
PORT=3000

# URL publique complète du site, SANS slash final. Utilisée pour les balises
# canoniques, Open Graph, le sitemap.xml, robots.txt, llms.txt et les
# données structurées (schema.org). Mettez à jour cette valeur avec votre
# nom de domaine réel avant la mise en production.
SITE_URL=https://www.votre-domaine.tn
